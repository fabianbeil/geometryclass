<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Geometrie-Konstruktionen</title>
<link rel=stylesheet href=style.css>
</head>
<body>
  <div id="toolbar">
  <button data-tool="pen" class="active icon-btn"
          aria-label="Stift" title="Stift">
    <i data-lucide="pencil"></i>
  </button>

  <label title="Strichstärke">Strich
    <select id="thickness">
      <option value="2" selected>Fein</option>
      <option value="4">Mittel</option>
      <option value="8">Dick</option>
      <option value="14">Sehr dick</option>
    </select>
  </label>

  <div class="swatches" role="group" aria-label="Stiftfarbe">
    <button type="button" class="color-swatch standard active"
            data-color="standard" aria-label="Standardfarbe" title="Standardfarbe"></button>
    <button type="button" class="color-swatch"
            data-color="#e53935" aria-label="Rot" title="Rot"></button>
    <button type="button" class="color-swatch"
            data-color="#fb8c00" aria-label="Orange" title="Orange"></button>
    <button type="button" class="color-swatch"
            data-color="#fdd835" aria-label="Gelb" title="Gelb"></button>
    <button type="button" class="color-swatch"
            data-color="#43a047" aria-label="Grün" title="Grün"></button>
    <button type="button" class="color-swatch"
            data-color="#1e88e5" aria-label="Blau" title="Blau"></button>
    <button type="button" class="color-swatch"
            data-color="#8e24aa" aria-label="Lila" title="Lila"></button>
  </div>

  <select id="penColor" hidden>
    <option value="standard" selected>Standard</option>
    <option value="#e53935">Rot</option>
    <option value="#fb8c00">Orange</option>
    <option value="#fdd835">Gelb</option>
    <option value="#43a047">Grün</option>
    <option value="#1e88e5">Blau</option>
    <option value="#8e24aa">Lila</option>
  </select>

  <button data-tool="eraser" class="icon-btn"
          aria-label="Radierer" title="Radierer">
    <i data-lucide="eraser"></i>
  </button>

  <label title="Radiermodus">Radieren
    <select id="eraseMode">
      <option value="partial">Bereich unter Cursor</option>
      <option value="whole" selected>Ganze Linie</option>
    </select>
  </label>

  <button data-tool="pan" class="icon-btn"
          aria-label="Verschieben" title="Verschieben">
    <i data-lucide="hand"></i>
  </button>

  <button id="rulerButton" class="icon-btn"
          aria-label="Geodreieck" title="Geodreieck">
    <i data-lucide="triangle"></i>
  </button>

  <button id="compassButton" class="icon-btn"
    aria-label="Zirkel" title="Zirkel">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
         fill="none" stroke="currentColor" stroke-width="1.7"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v3m-2 0h4l-2 2-7 12m7-12 7 12M5 20l2-1m12 1-2-1M8.5 13h7" />
      <circle cx="12" cy="6" r="1.5" />
    </svg>
  </button>


  <button id="themeButton" class="icon-btn"
          aria-label="Theme wechseln" title="Theme wechseln">
    <i data-lucide="moon"></i>
  </button>

  <button id="saveButton" class="icon-btn"
          aria-label="Zeichnung speichern" title="Zeichnung speichern">
    <i data-lucide="save"></i>
  </button>

  <button id="loadButton" class="icon-btn"
          aria-label="Zeichnung laden" title="Zeichnung laden">
    <i data-lucide="folder-open"></i>
  </button>

  <input id="loadFile" type="file" accept=".json,application/json" hidden>

  <button id="undoButton" class="icon-btn" aria-label="Rückgängig" title="Rückgängig (Strg+Z)" disabled>
    <i data-lucide="undo-2"></i>
  </button>
  <button id="redoButton" class="icon-btn" aria-label="Wiederherstellen" title="Wiederherstellen (Strg+Y)" disabled>
    <i data-lucide="redo-2"></i>
  </button>
  <button id="exportSvgButton" class="icon-btn" aria-label="Als SVG exportieren" title="Als SVG exportieren">
    <i data-lucide="file-image"></i>
  </button>
  <button id="exportSvgWithToolsButton" class="icon-btn" aria-label="Als SVG mit Geodreieck und Zirkel exportieren" title="SVG mit Geodreieck und Zirkel exportieren">
    <i data-lucide="pencil-ruler"></i>
  </button>

  <button id="clearButton" class="icon-btn"
          aria-label="Alles löschen" title="Alles löschen">
    <i data-lucide="trash-2"></i>
  </button>

  <span id="status">Mausrad: Zoom · Verschieben: Werkzeug oder mittlere Maustaste</span>
</div>

  <canvas id="canvas"></canvas>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>
    (() => {
      const canvas = document.querySelector("#canvas");
      const ctx = canvas.getContext("2d");
      const body = document.body;
      const grid = 30; // Ein Kästchen in Weltkoordinaten
      const cm = 2 * grid; // 1 cm entspricht immer zwei Kästchen

      let zoom = 1.05;
      let panX = 90, panY = 180;
      let tool = "pen";
      let strokes = [];
      let activeStroke = null;
      let pointerDown = false;
      let drag = null;
      let ruler = {
        visible: false,
        x: 180, y: 320,
        w: 600, h: 300,
        angle: 0
      };
      let compass = {
        visible: false,
        x: 420, y: 320,       // Mittelpunkt der Einstichspitze
        angle: 0,              // Richtung von der Einstichspitze zur Mine
        radius: 2 * 8 * grid * Math.sin(10 * Math.PI / 180),
        drawing: false,
        draggingTip: false
      };


      const dpr = () => window.devicePixelRatio || 1;
      let filenameTimestamp = null;
      let saveFileHandle = null;
      const undoStack = [];
      const redoStack = [];
      const historyLimit = 100;

      function snapshot() {
        return JSON.parse(JSON.stringify({
          strokes, ruler, compass: {
            visible: compass.visible,
            x: compass.x, y: compass.y,
            angle: compass.angle, radius: compass.radius
          },
          view: { zoom, panX, panY }
        }));
      }

      function updateHistoryButtons() {
        document.querySelector("#undoButton").disabled = undoStack.length === 0;
        document.querySelector("#redoButton").disabled = redoStack.length === 0;
      }

      function recordUndo() {
        undoStack.push(snapshot());
        if (undoStack.length > historyLimit) undoStack.shift();
        redoStack.length = 0;
        updateHistoryButtons();
      }

      function restoreSnapshot(state) {
        strokes = state.strokes;
        ruler = state.ruler;
        compass = { ...compass, ...state.compass, drawing: false, draggingTip: false };
        zoom = state.view.zoom;
        panX = state.view.panX;
        panY = state.view.panY;
        activeStroke = null;
        drag = null;
        pointerDown = false;
        draw();
        updateHistoryButtons();
      }

      function undo() {
        if (!undoStack.length) return;
        redoStack.push(snapshot());
        restoreSnapshot(undoStack.pop());
      }

      function redo() {
        if (!redoStack.length) return;
        undoStack.push(snapshot());
        restoreSnapshot(redoStack.pop());
      }

      document.querySelector("#undoButton").addEventListener("click", undo);
      document.querySelector("#redoButton").addEventListener("click", redo);
      window.addEventListener("keydown", event => {
        if (!(event.ctrlKey || event.metaKey) || event.altKey) return;
        const key = event.key.toLowerCase();
        if (key === "z") {
          event.preventDefault();
          if (event.shiftKey) redo();
          else undo();
        } else if (key === "y") {
          event.preventDefault();
          redo();
        }
      });

      function createTimestamp() {
        const now = new Date();
        const pad = value => String(value).padStart(2, "0");

        return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}`;
      }

      function resize() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = Math.round(rect.width * dpr());
        canvas.height = Math.round(rect.height * dpr());
        draw();
      }
      window.addEventListener("resize", resize);

      function screenToWorld(sx, sy) {
        return { x: (sx - panX) / zoom, y: (sy - panY) / zoom };
      }
      function worldToScreen(p) {
        return { x: p.x * zoom + panX, y: p.y * zoom + panY };
      }
      function pointerPos(e) {
        const r = canvas.getBoundingClientRect();
        return { x: e.clientX - r.left, y: e.clientY - r.top };
      }
      function localToWorld(x, y) {
        const c = Math.cos(ruler.angle), s = Math.sin(ruler.angle);
        return { x: ruler.x + x * c - y * s, y: ruler.y + x * s + y * c };
      }
      function worldToLocal(p) {
        const dx = p.x - ruler.x, dy = p.y - ruler.y;
        const c = Math.cos(ruler.angle), s = Math.sin(ruler.angle);
        return { x: dx * c + dy * s, y: -dx * s + dy * c };
      }
      function localToScreen(x, y) {
        return worldToScreen(localToWorld(x, y));
      }
      function rulerZeroLocal() {
    const radius = Math.min(ruler.w * 0.34, ruler.h * 0.72);
    return { x: ruler.w / 2, y: 0 };
        }

      function setCanvasTransform() {
        const d = dpr();
        ctx.setTransform(d * zoom, 0, 0, d * zoom, d * panX, d * panY);
      }

      function drawGrid() {
  const dark = body.classList.contains("dark");
  const w = canvas.width / dpr();
  const h = canvas.height / dpr();

  const left = -panX / zoom;
  const top = -panY / zoom;
  const right = left + w / zoom;
  const bottom = top + h / zoom;
  const x0 = Math.floor(left / grid) * grid;
  const y0 = Math.floor(top / grid) * grid;

  ctx.fillStyle = dark ? "#171a20" : "#fff";
  ctx.fillRect(left, top, right - left, bottom - top);

  ctx.lineWidth = 1.5 / zoom;
  ctx.strokeStyle = dark ? "#343b45" : "#dce3eb";

  for (let x = x0; x <= right; x += grid) {
    ctx.beginPath();
    ctx.moveTo(x, top);
    ctx.lineTo(x, bottom);
    ctx.stroke();
  }

  for (let y = y0; y <= bottom; y += grid) {
    ctx.beginPath();
    ctx.moveTo(left, y);
    ctx.lineTo(right, y);
    ctx.stroke();
  }
}


      function drawStrokes() {
        for (const stroke of strokes) {
          for (const part of stroke.parts) {
            if (part.length < 1) continue;
            ctx.beginPath();
            ctx.moveTo(part[0].x, part[0].y);
            for (let i = 1; i < part.length; i++) {
              ctx.lineTo(part[i].x, part[i].y);
            }
            const isStandard = stroke.color === "standard" ||  stroke.color === "#202124" ||  stroke.color === "#f5f5f5";

            ctx.strokeStyle = isStandard ? (body.classList.contains("dark") ? "#ffffff" : "#000000"): stroke.color;
            ctx.lineWidth = stroke.width;
            ctx.lineCap = "round";
            ctx.lineJoin = "round";
            ctx.stroke();
          }
        }
      }

function drawRuler() {
  if (!ruler.visible) return;

  ctx.save();
  ctx.translate(ruler.x, ruler.y);
  ctx.rotate(ruler.angle);

  const mid = ruler.w / 2;
  const dark = body.classList.contains("dark");
  const zero = rulerZeroLocal();
  const radius = ruler.h*0.65;

  // Gleichschenkliges Geodreieck.
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(ruler.w, 0);
  ctx.lineTo(mid, -ruler.h);
  ctx.closePath();
  ctx.fillStyle = dark
    ? "rgba(135,190,220,.19)"
    : "rgba(115,175,220,.22)";
  ctx.fill();
  ctx.strokeStyle = dark
    ? "rgba(190,220,245,.9)"
    : "rgba(45,95,135,.9)";
  ctx.lineWidth = 2 / zoom;
  ctx.stroke();

  // Fünf parallele Hilfslinien im 5-mm-Abstand zur Grundkante.
  ctx.save();
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(ruler.w, 0);
  ctx.lineTo(mid, -ruler.h);
  ctx.closePath();
  ctx.clip();
  ctx.lineWidth = 1.8 / zoom;
  ctx.strokeStyle = dark ? "rgba(190,220,245,.45)" : "rgba(45,95,135,.42)";
  for (let i = 1; i <= 5; i++) {
    const y = -i * cm / 2;
    const halfSpan = mid * (1 + y / ruler.h);
    if (halfSpan <= 0) continue;
    ctx.beginPath();
    ctx.moveTo(mid - halfSpan, y);
    ctx.lineTo(mid + halfSpan, y);
    ctx.stroke();
  }
  ctx.restore();

  // Mittellinie: 0°-Achse durch die Spitze.
  ctx.beginPath();
  ctx.moveTo(mid, 0);
  ctx.lineTo(mid, -ruler.h);
  ctx.stroke();

  // Untere Zentimeterskala: 0 in der Mitte,
  // positive Werte nach links und rechts.
  const tickStep = cm / 10; // 1 mm; cm bleibt an das Raster gekoppelt
  const ticksLeft = Math.floor(mid / tickStep);
  const ticksRight = Math.floor((ruler.w - mid) / tickStep);

  for (let i = -ticksLeft + 1; i < ticksRight; i++) {
    const x = mid + i * tickStep;
    const absI = Math.abs(i);
    const isCm = absI % 10 === 0;
    const isHalfCm = absI % 5 === 0;
    const length = isCm ? 18 : (isHalfCm ? 12 : 7);

    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, -length);
    ctx.stroke();

    if (isCm) {
      ctx.fillStyle = dark ? "#edf5ff" : "#263746";
      ctx.font = `${13 / zoom}px sans-serif`;
      ctx.textAlign = "center";
      ctx.textBaseline = "alphabetic";
      ctx.fillText(String(absI / 10), x, -22);
    }
  }

  // Winkelskala: 0° links bis 180° rechts, mit gegenläufiger Innenskala.
  ctx.beginPath();
  ctx.arc(mid, 0, radius, Math.PI, 0, false);
  ctx.stroke();

  for (let deg = 0; deg <= 180; deg++) {
    const angle = Math.PI + deg * Math.PI / 180;
    const major = deg % 10 === 0;
    const medium = deg % 5 === 0;
    const tickLength = major ? 14 : (medium ? 10 : 5);
    const innerRadius = radius - tickLength;

    ctx.beginPath();
    ctx.moveTo(
      mid + Math.cos(angle) * innerRadius,
      Math.sin(angle) * innerRadius
    );
    ctx.lineTo(
      mid + Math.cos(angle) * radius,
      Math.sin(angle) * radius
    );
    ctx.stroke();

    if (major) {
      ctx.fillStyle = dark ? "#edf5ff" : "#263746";
      ctx.font = `${12 / zoom}px sans-serif`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      const labelRadius = radius - 26;
      ctx.fillText(String(deg), mid + Math.cos(angle) * labelRadius, Math.sin(angle) * labelRadius);
      ctx.fillText(String(180 - deg), mid + Math.cos(angle) * (radius - 48), Math.sin(angle) * (radius - 48));
    }
  }

  // Deutlich sichtbarer Nullpunkt in der Mitte des Winkelbogens.
  ctx.beginPath();
  ctx.arc(zero.x, zero.y, 4 / zoom, 0, Math.PI * 2);
  ctx.fillStyle = "#e53935";
  ctx.fill();

  ctx.fillStyle = dark ? "#edf5ff" : "#263746";
  ctx.font = `${13 / zoom}px sans-serif`;
  ctx.textAlign = "center";
  ctx.textBaseline = "bottom";
  ctx.fillText("90", zero.x, zero.y - 8 / zoom);

  // Gradstriche an beiden schrägen Kanten.
  // Jeder Strich liegt am Schnittpunkt der Kante mit dem entsprechenden
  // Gradstrahl vom Nullpunkt aus.
  const apex = { x: mid, y: -ruler.h };

  function cross(a, b) {
    return a.x * b.y - a.y * b.x;
  }

    function drawSlantedDegreeScale(side) {
    const end = side === "left"
      ? { x: 0, y: 0 }
      : { x: ruler.w, y: 0 };

    const edge = { x: end.x - apex.x, y: end.y - apex.y };
    const edgeLength = Math.hypot(edge.x, edge.y);
    const normal = {
      x: side === "left" ? -edge.y / edgeLength : edge.y / edgeLength,
      y: side === "left" ? edge.x / edgeLength : -edge.x / edgeLength
    };

    // Der Halbkreis reicht von -90° bis +90°.
    // Beide schrägen Kanten bekommen positive Werte ab der 0°-Achse.
    for (let deg = 0; deg <= 90; deg++) {
      const a = deg * Math.PI / 180;
      const direction = side === "left"
        ? { x: -Math.sin(a), y: -Math.cos(a) }
        : { x: Math.sin(a), y: -Math.cos(a) };

      const fromZeroToApex = {
        x: apex.x - zero.x,
        y: apex.y - zero.y
      };

      const denominator = cross(direction, edge);
      if (Math.abs(denominator) < 1e-9) continue;

      const t = cross(fromZeroToApex, direction) / denominator;
      if (t < -1e-6 || t > 1 + 1e-6) continue;

      const point = {
        x: apex.x + edge.x * t,
        y: apex.y + edge.y * t
      };

      // Markierungen enden exakt an der Kante und ragen nur nach innen.
      const major = deg % 10 === 0;
      const medium = deg % 5 === 0;
      const length = major ? 14 : (medium ? 10 : 5);

      ctx.beginPath();
      ctx.moveTo(point.x, point.y);
      ctx.lineTo(point.x - normal.x * length, point.y - normal.y * length);
      ctx.stroke();

      if (major) {
        ctx.fillStyle = dark ? "#edf5ff" : "#263746";
        ctx.font = `${11 / zoom}px sans-serif`;
        ctx.textAlign = side === "left" ? "right" : "left";
        ctx.textBaseline = "middle";
        ctx.fillText(
        String(90 - deg),
          point.x + normal.x * 17,
          point.y + normal.y * 17
        );
      }
    }
  }

  drawSlantedDegreeScale("left");
  drawSlantedDegreeScale("right");

  // Drehgriff über der Spitze und Skaliergriff am rechten Eck.
  const handleRadius = 8 / zoom;
  for (const p of [
    { x: ruler.w, y: 0 },
    { x: mid, y: -ruler.h - 30 }
  ]) {
    ctx.beginPath();
    ctx.arc(p.x, p.y, handleRadius, 0, Math.PI * 2);
    ctx.fillStyle = dark ? "#d8e8ff" : "#fff";
    ctx.fill();
    ctx.strokeStyle = "#367fc1";
    ctx.lineWidth = 2 / zoom;
    ctx.stroke();
  }

  ctx.textAlign = "left";
  ctx.textBaseline = "alphabetic";
  ctx.restore();
}

function compassPoint(localX, localY) {
  const c = Math.cos(compass.angle);
  const s = Math.sin(compass.angle);
  return {
    x: compass.x + localX * c - localY * s,
    y: compass.y + localX * s + localY * c
  };
}

function compassTip() {
  return compassPoint(compass.radius, 0);
}

function compassArmLength() {
  const maxOpening = 160 * Math.PI / 180;
  return Math.max(8 * grid, compass.radius / (2 * Math.sin(maxOpening / 2)));
}

function compassGrip() {
  const x = compass.radius / 2;
  const y = -Math.sqrt(Math.max(0, compassArmLength() ** 2 - x ** 2));
  return compassPoint(x, y - 30 / zoom - 23);
}

function compassRotateControl() {
  const x = compass.radius / 4;
  const y = (-Math.sqrt(Math.max(0, compassArmLength() ** 2 - (compass.radius / 2) ** 2)) - 30 / zoom) / 2;
  return compassPoint(x, y);
}

function drawCompass() {
  if (!compass.visible) return;

  const dark = body.classList.contains("dark");
  const headX = compass.radius / 2;
  const headY = -Math.sqrt(Math.max(0, compassArmLength() ** 2 - headX ** 2));

  ctx.save();
  ctx.translate(compass.x, compass.y);
  ctx.rotate(compass.angle);

  // Zwei orangefarbene Schenkel, inspiriert von der Vorlage.
  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  ctx.strokeStyle = "#ed8b19";
  ctx.lineWidth = 12 / zoom;

  ctx.beginPath();
  ctx.moveTo(headX, headY - 30 / zoom);
  ctx.lineTo(0, -30 / zoom);
  ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(headX, headY - 30 / zoom);
  ctx.lineTo(compass.radius, -30 / zoom);
  ctx.stroke();

  // Dunkles Gelenk und Griff.
  ctx.fillStyle = "#263746";
  ctx.beginPath();
  ctx.roundRect(headX - 15, headY - 30 / zoom - 13, 30, 27, 5 / zoom);
  ctx.fill();
  ctx.fillRect(headX - 6, headY - 30 / zoom - 32, 12, 19);

  // Spitzen sind doppelt so lang; ihre Endpunkte liegen exakt auf Pin und Mine.
  ctx.fillStyle = dark ? "#eef1f5" : "#263746";
  ctx.beginPath();
  ctx.moveTo(-5 / zoom, -30 / zoom);
  ctx.lineTo(5 / zoom, -30 / zoom);
  ctx.lineTo(0, 0);
  ctx.closePath();
  ctx.fill();

  // Zeichenbein und Bleistiftmine.
  ctx.fillStyle = "#374957";
  ctx.beginPath();
  ctx.moveTo(compass.radius - 5 / zoom, -30 / zoom);
  ctx.lineTo(compass.radius + 5 / zoom, -30 / zoom);
  ctx.lineTo(compass.radius, 0);
  ctx.closePath();
  ctx.fill();

  // Ziehgriff und verschiebbare Spitzen als Bildschirm-Handles.
  for (const [x, y, color, r] of [
    [headX, headY - 30 / zoom - 23, "#263746", 8],
    [0, 0, "#367fc1", 7],
    [compass.radius, 0, "#367fc1", 7]
  ]) {
    ctx.beginPath();
    ctx.arc(x, y, r / zoom, 0, Math.PI * 2);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = dark ? "#eef1f5" : "#fff";
    ctx.lineWidth = 2 / zoom;
    ctx.stroke();
  }

  // Drehknopf am Einsticharm. Ziehen dreht den Zirkel, ohne zu zeichnen.
  const rotateControl = compassRotateControl();
  const rotateLocal = {
    x: (rotateControl.x - compass.x) * Math.cos(compass.angle) + (rotateControl.y - compass.y) * Math.sin(compass.angle),
    y: -(rotateControl.x - compass.x) * Math.sin(compass.angle) + (rotateControl.y - compass.y) * Math.cos(compass.angle)
  };
  const rotateX = rotateLocal.x;
  const rotateY = rotateLocal.y;
  ctx.beginPath();
  ctx.arc(rotateX, rotateY, 9 / zoom, 0, Math.PI * 2);
  ctx.fillStyle = "#8e24aa";
  ctx.fill();
  ctx.strokeStyle = dark ? "#eef1f5" : "#fff";
  ctx.lineWidth = 2 / zoom;
  ctx.stroke();
  ctx.beginPath();
  ctx.arc(rotateX, rotateY, 4 / zoom, -Math.PI * 0.8, Math.PI * 0.65);
  ctx.strokeStyle = "#fff";
  ctx.lineWidth = 1.5 / zoom;
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(rotateX + 3 / zoom, rotateY - 4 / zoom);
  ctx.lineTo(rotateX + 5 / zoom, rotateY - 1 / zoom);
  ctx.lineTo(rotateX + 1 / zoom, rotateY - 1 / zoom);
  ctx.fillStyle = "#fff";
  ctx.fill();

  ctx.restore();
}

function drawCompassMagnifier() {
  if (!compass.visible || !compass.draggingTip ||
      !["compassPin", "compassPencil"].includes(drag?.kind)) return;

  const d = dpr();
  const focus = drag.kind === "compassPin" ? { x: compass.x, y: compass.y } : compassTip();
  const focusScreen = worldToScreen(focus);
  const lensX = focusScreen.x + (focus.x < compass.x ? 68 : -68);
  const lensY = focusScreen.y - 68;
  const lensRadius = 54;
  const magnification = 2.5;

  ctx.save();
  ctx.setTransform(d, 0, 0, d, 0, 0);

  // Kreisförmige Lupe nahe der Einstichspitze.
  ctx.beginPath();
  ctx.arc(lensX, lensY, lensRadius, 0, Math.PI * 2);
  ctx.clip();
  ctx.fillStyle = body.classList.contains("dark") ? "#171a20" : "#fff";
  ctx.fillRect(
    lensX - lensRadius, lensY - lensRadius,
    lensRadius * 2, lensRadius * 2
  );

  // Weltkoordinaten so transformieren, dass die gezogene Spitze in der Lupenmitte liegt.
  ctx.setTransform(
    d * zoom * magnification, 0, 0, d * zoom * magnification,
    d * (lensX - focus.x * zoom * magnification),
    d * (lensY - focus.y * zoom * magnification)
  );

  const range = lensRadius / (zoom * magnification);
  const x0 = Math.floor((focus.x - range) / grid) * grid;
  const y0 = Math.floor((focus.y - range) / grid) * grid;
  ctx.strokeStyle = body.classList.contains("dark") ? "#343b45" : "#dce3eb";
  ctx.lineWidth = 0.7 / (zoom * magnification);

  for (let x = x0; x <= focus.x + range; x += grid) {
    ctx.beginPath();
    ctx.moveTo(x, focus.y - range);
    ctx.lineTo(x, focus.y + range);
    ctx.stroke();
  }
  for (let y = y0; y <= focus.y + range; y += grid) {
    ctx.beginPath();
    ctx.moveTo(focus.x - range, y);
    ctx.lineTo(focus.x + range, y);
    ctx.stroke();
  }

  drawStrokes();
  ctx.restore();

  // Rahmen und Fadenkreuz der Lupe.
  ctx.setTransform(d, 0, 0, d, 0, 0);
  ctx.beginPath();
  ctx.arc(lensX, lensY, lensRadius, 0, Math.PI * 2);
  ctx.strokeStyle = "#367fc1";
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(lensX - 7, lensY);
  ctx.lineTo(lensX + 7, lensY);
  ctx.moveTo(lensX, lensY - 7);
  ctx.lineTo(lensX, lensY + 7);
  ctx.stroke();
}

function drawRulerMagnifier() {
  if (drag?.kind !== "rulerMove") return;

  const d = dpr();
  const pivotLocal = rulerZeroLocal();
  const focus = localToWorld(pivotLocal.x, pivotLocal.y);
  const focusScreen = worldToScreen(focus);
  const lensRadius = 54;
  const lensX = focusScreen.x + 68;
  const lensY = focusScreen.y - 68;
  const magnification = 2.5;

  ctx.save();
  ctx.setTransform(d, 0, 0, d, 0, 0);
  ctx.beginPath();
  ctx.arc(lensX, lensY, lensRadius, 0, Math.PI * 2);
  ctx.clip();
  ctx.fillStyle = body.classList.contains("dark") ? "#171a20" : "#fff";
  ctx.fillRect(lensX - lensRadius, lensY - lensRadius, lensRadius * 2, lensRadius * 2);

  ctx.setTransform(
    d * zoom * magnification, 0, 0, d * zoom * magnification,
    d * (lensX - focus.x * zoom * magnification),
    d * (lensY - focus.y * zoom * magnification)
  );
  const range = lensRadius / (zoom * magnification);
  const x0 = Math.floor((focus.x - range) / grid) * grid;
  const y0 = Math.floor((focus.y - range) / grid) * grid;
  ctx.strokeStyle = body.classList.contains("dark") ? "#343b45" : "#dce3eb";
  ctx.lineWidth = 0.7 / (zoom * magnification);
  for (let x = x0; x <= focus.x + range; x += grid) {
    ctx.beginPath(); ctx.moveTo(x, focus.y - range); ctx.lineTo(x, focus.y + range); ctx.stroke();
  }
  for (let y = y0; y <= focus.y + range; y += grid) {
    ctx.beginPath(); ctx.moveTo(focus.x - range, y); ctx.lineTo(focus.x + range, y); ctx.stroke();
  }
  drawStrokes();
  ctx.restore();

  ctx.setTransform(d, 0, 0, d, 0, 0);
  ctx.beginPath();
  ctx.arc(lensX, lensY, lensRadius, 0, Math.PI * 2);
  ctx.strokeStyle = "#367fc1";
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(lensX - 7, lensY); ctx.lineTo(lensX + 7, lensY);
  ctx.moveTo(lensX, lensY - 7); ctx.lineTo(lensX, lensY + 7);
  ctx.stroke();
}

function startCompassDrawing(pointerWorld) {
  if (compass.drawing) return;

  recordUndo();
  compass.drawing = true;
  const stroke = {
    width: Number(document.querySelector("#thickness").value) / zoom,
    color: document.querySelector("#penColor").value,
    parts: [[compassTip()]]
  };
  strokes.push(stroke);

  drag = {
    kind: "compassDraw",
    lastPointerAngle: Math.atan2(pointerWorld.y - compass.y, pointerWorld.x - compass.x)
  };
}


      function draw() {
        const d = dpr();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        setCanvasTransform();
        drawGrid();
        drawStrokes();
        drawRuler();
        drawRulerRayPreview();
        drawCompass();
        drawCompassMagnifier();
        drawRulerMagnifier();
      }

      function insideRuler(local) {
  if (local.x < 0 || local.x > ruler.w || local.y > 0) return false;

  const halfWidth = ruler.w / 2;
  const heightAtX =
    ruler.h * (1 - Math.abs(local.x - halfWidth) / halfWidth);

  return -local.y <= heightAtX;
}

      function distanceToSegment(p, a, b) {
        const dx = b.x - a.x, dy = b.y - a.y;
        const len2 = dx * dx + dy * dy;
        const t = len2 ? Math.max(0, Math.min(1,
          ((p.x - a.x) * dx + (p.y - a.y) * dy) / len2)) : 0;
        const q = { x: a.x + t * dx, y: a.y + t * dy };
        return { distance: Math.hypot(p.x - q.x, p.y - q.y), point: q };
      }

      function nearestRulerEdge(world, edgeIndex = null) {
  const p = worldToLocal(world);
  const mid = ruler.w / 2;

  const edges = [
    [{ x: 0, y: 0 }, { x: ruler.w, y: 0 }],          // Grundkante
    [{ x: 0, y: 0 }, { x: mid, y: -ruler.h }],       // linke Schräge
    [{ x: mid, y: -ruler.h }, { x: ruler.w, y: 0 }]  // rechte Schräge
  ];

  let best = null;

  for (let index = 0; index < edges.length; index++) {
    if (edgeIndex !== null && index !== edgeIndex) continue;
    const [a, b] = edges[index];
    const result = distanceToSegment(p, a, b);
    if (!best || result.distance < best.distance) best = { ...result, index };
  }

  return best ? { ...best, point: localToWorld(best.point.x, best.point.y) } : null;
}


      function snapPoint(world, edgeIndex = null) {
        if (!ruler.visible) return world;
        const nearest = nearestRulerEdge(world, edgeIndex);
        if (!nearest) return world;
        return edgeIndex !== null || nearest.distance * zoom < 20
          ? nearest.point
          : world;
      }

      function rulerProtractorHit(world) {
        const local = worldToLocal(world);
        const radius = ruler.h * 0.65;
        const distance = Math.hypot(local.x - ruler.w / 2, local.y);
        return local.y <= 0 && Math.abs(distance - radius) * zoom < 18;
      }

      function rulerRayFromPointer(world) {
        const local = worldToLocal(world);
        const mid = ruler.w / 2;
        const origin = { x: mid, y: 0 };
        const angle = Math.max(-Math.PI / 2, Math.min(Math.PI / 2,
          Math.atan2(local.x - mid, -local.y)));
        const side = angle < 0 ? "left" : "right";
        const direction = {
          x: (side === "left" ? -1 : 1) * Math.sin(Math.abs(angle)),
          y: -Math.cos(angle)
        };
        const apex = { x: mid, y: -ruler.h };
        const edgeEnd = { x: side === "left" ? 0 : ruler.w, y: 0 };
        const edge = { x: edgeEnd.x - apex.x, y: edgeEnd.y - apex.y };
        const cross = (a, b) => a.x * b.y - a.y * b.x;
        const denominator = cross(direction, edge);
        const distance = Math.abs(denominator) < 1e-9
          ? ruler.h
          : cross({ x: apex.x - origin.x, y: apex.y - origin.y }, edge) / denominator;
        const overhang = cm * 3 / 10; // 3 mm
        const end = {
          x: origin.x + direction.x * (distance + overhang),
          y: origin.y + direction.y * (distance + overhang)
        };

        return {
          start: localToWorld(origin.x, origin.y),
          end: localToWorld(end.x, end.y)
        };
      }

      function drawRulerRayPreview() {
        if (drag?.kind !== "rulerRay" || !drag.line) return;
        const color = document.querySelector("#penColor").value;
        const standard = color === "standard" || color === "#202124" || color === "#f5f5f5";
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(drag.line.start.x, drag.line.start.y);
        ctx.lineTo(drag.line.end.x, drag.line.end.y);
        ctx.strokeStyle = standard ? (body.classList.contains("dark") ? "#fff" : "#000") : color;
        ctx.lineWidth = Number(document.querySelector("#thickness").value) / zoom;
        ctx.lineCap = "round";
        ctx.stroke();
        ctx.restore();
      }

      function startPan(p) {
        recordUndo();
        drag = { kind: "pan", x: p.x, y: p.y, panX, panY };
      }

      canvas.addEventListener("pointerdown", e => {
        canvas.setPointerCapture(e.pointerId);
        const screen = pointerPos(e);
        const world = screenToWorld(screen.x, screen.y);
        pointerDown = true;
        if (compass.visible && !compass.drawing) {
        const tipScreen = worldToScreen(compassTip());
        const gripScreen = worldToScreen(compassGrip());
        const rotateScreen = worldToScreen(compassRotateControl());
        const pinScreen = worldToScreen({ x: compass.x, y: compass.y });
        const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);

        if (dist(screen, rotateScreen) < 18) {
          recordUndo();
          drag = {
            kind: "compassRotate",
            lastPointerAngle: Math.atan2(world.y - compass.y, world.x - compass.x),
            moved: false
          };
          return;
        }

        if (dist(screen, gripScreen) < 18) {
          startCompassDrawing(world);
          draw();
          return;
        }

        if (dist(screen, pinScreen) < 18) {
          recordUndo();
          compass.draggingTip = true;
          drag = {
            kind: "compassPin",
            offsetX: world.x - compass.x,
            offsetY: world.y - compass.y
          };
          draw();
          return;
        }

        if (dist(screen, tipScreen) < 18) {
          recordUndo();
          compass.draggingTip = true;
          drag = { kind: "compassPencil" };
          draw();
          return;
        }
      }

        if (tool !== "eraser" && ruler.visible && rulerProtractorHit(world)) {
          recordUndo();
          drag = { kind: "rulerRay", line: rulerRayFromPointer(world) };
          draw();
          return;
        }

        if (e.button === 1 || tool === "pan") {
          startPan(screen); return;
        }

        if (ruler.visible) {
          const scale = localToScreen(ruler.w, 0);
          const rotate = localToScreen(ruler.w / 2, -ruler.h - 30);
          const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
          if (dist(screen, scale) < 18) {
            recordUndo();
            drag = { kind: "scale" }; return;
          }
          if (dist(screen, rotate) < 18) {
            recordUndo();
            drag = { kind: "rotate" }; return;
          }
          const rulerEdgeHit = tool === "pen" ? nearestRulerEdge(world) : null;
          const drawingOnRulerEdge = rulerEdgeHit && rulerEdgeHit.distance * zoom < 20;
          if (!drawingOnRulerEdge && insideRuler(worldToLocal(world))) {
            recordUndo();
            drag = { kind: "rulerMove", offsetX: world.x - ruler.x, offsetY: world.y - ruler.y };
            return;
          }
        }

        if (tool === "eraser") {
          recordUndo();
          eraseAt(world);
          drag = { kind: "erase" };
          draw();
          return;
        }

        if (tool === "pen") {
          recordUndo();
          const nearestEdge = ruler.visible ? nearestRulerEdge(world) : null;
          const rulerEdge = nearestEdge && nearestEdge.distance * zoom < 20
            ? nearestEdge.index
            : null;
          const first = rulerEdge === null ? world : nearestEdge.point;
          activeStroke = {
            width: Number(document.querySelector("#thickness").value) / zoom,
            color: document.querySelector("#penColor").value,
            parts: [[first]]
          };
          strokes.push(activeStroke);
          drag = { kind: "draw", rulerEdge };
          draw();
        }
      });

      canvas.addEventListener("pointermove", e => {
        if (!pointerDown) return;
        const screen = pointerPos(e);
        const world = screenToWorld(screen.x, screen.y);
        if (drag?.kind === "rulerRay") {
          drag.line = rulerRayFromPointer(world);
        } else if (drag?.kind === "compassPin") {
          compass.x = world.x - drag.offsetX;
          compass.y = world.y - drag.offsetY;
        } else if (drag?.kind === "compassPencil") {
          const dx = world.x - compass.x;
          const dy = world.y - compass.y;
          compass.radius = Math.max(35, Math.hypot(dx, dy));
          compass.angle = Math.atan2(dy, dx);
        } else if (drag?.kind === "compassDraw") {
          const pointerAngle = Math.atan2(world.y - compass.y, world.x - compass.x);
          let delta = pointerAngle - drag.lastPointerAngle;
          while (delta > Math.PI) delta -= Math.PI * 2;
          while (delta < -Math.PI) delta += Math.PI * 2;
          const steps = Math.max(1, Math.ceil(Math.abs(delta) * compass.radius / 4));
          const part = strokes[strokes.length - 1].parts[0];
          const startAngle = compass.angle;
          const endAngle = startAngle + delta;
          for (let i = 1; i <= steps; i++) {
            const nextAngle = startAngle + delta * i / steps;
            part.push({
              x: compass.x + compass.radius * Math.cos(nextAngle),
              y: compass.y + compass.radius * Math.sin(nextAngle)
            });
          }
          compass.angle = endAngle;
          drag.lastPointerAngle = pointerAngle;
        } else if (drag?.kind === "compassRotate") {
          const pointerAngle = Math.atan2(world.y - compass.y, world.x - compass.x);
          let delta = pointerAngle - drag.lastPointerAngle;
          while (delta > Math.PI) delta -= Math.PI * 2;
          while (delta < -Math.PI) delta += Math.PI * 2;
          if (Math.abs(delta) > 0.001) drag.moved = true;
          compass.angle += delta;
          drag.lastPointerAngle = pointerAngle;
        } else if (drag?.kind === "pan") {
          panX = drag.panX + screen.x - drag.x;
          panY = drag.panY + screen.y - drag.y;
        } else if (drag?.kind === "rulerMove") {
          ruler.x = world.x - drag.offsetX;
          ruler.y = world.y - drag.offsetY;
        } else if (drag?.kind === "rotate") {
        const zero = rulerZeroLocal();

        // Weltposition des Nullpunkts vor der Drehung festhalten.
        const fixedZero = localToWorld(zero.x, zero.y);

        // Der Drehgriff liegt senkrecht oberhalb des Nullpunkts.
        ruler.angle =
            Math.atan2(world.y - fixedZero.y, world.x - fixedZero.x) + Math.PI / 2;

        // Geodreieck so verschieben, dass der Nullpunkt fest bleibt.
        const c = Math.cos(ruler.angle);
        const s = Math.sin(ruler.angle);
        ruler.x = fixedZero.x - (zero.x * c - zero.y * s);
        ruler.y = fixedZero.y - (zero.x * s + zero.y * c);

        } else if (drag?.kind === "scale") {
          const local = worldToLocal(world);
          const newW = Math.max(240, local.x);
          ruler.h = ruler.h * (newW / ruler.w);
          ruler.w = newW;
        } else if (drag?.kind === "draw" && activeStroke) {
          const p = snapPoint(world, drag.rulerEdge);
          const part = activeStroke.parts[activeStroke.parts.length - 1];
          if (Math.hypot(p.x - part[part.length - 1].x, p.y - part[part.length - 1].y) > 1) {
            part.push(p);
          }
        } else if (drag?.kind === "erase") {
          eraseAt(world);
        }
        draw();
      });

      function eraseAt(world) {
        const radius = 13 / zoom;
        const mode = document.querySelector("#eraseMode").value;
        if (mode === "whole") {
          strokes = strokes.filter(stroke => !stroke.parts.some(part =>
            part.some((p, i) => Math.hypot(p.x - world.x, p.y - world.y) < radius ||
              (i > 0 && distanceToSegment(world, part[i - 1], p).distance < radius))));
          return;
        }

        const updated = [];
        for (const stroke of strokes) {
          const newParts = [];
          for (const part of stroke.parts) {
            let current = [];
            const samples = [];
            for (let i = 0; i < part.length; i++) {
              if (i === 0) samples.push(part[i]);
              else {
                const a = part[i - 1], b = part[i];
                const count = Math.max(1, Math.ceil(Math.hypot(b.x - a.x, b.y - a.y) / (radius / 2)));
                for (let j = 1; j <= count; j++) samples.push({
                  x: a.x + (b.x - a.x) * j / count,
                  y: a.y + (b.y - a.y) * j / count
                });
              }
            }
            for (const p of samples) {
              if (Math.hypot(p.x - world.x, p.y - world.y) < radius) {
                if (current.length) newParts.push(current);
                current = [];
              } else {
                current.push(p);
              }
            }
            if (current.length) newParts.push(current);
          }
          stroke.parts = newParts;
          if (newParts.length) updated.push(stroke);
        }
        strokes = updated;
      }

      canvas.addEventListener("pointerup", () => {
        pointerDown = false;
        activeStroke = null;
        if (drag?.kind === "compassDraw") compass.drawing = false;
        if (drag?.kind === "compassRotate" && !drag.moved) {
          compass.angle += Math.PI / 12;
        }
        if (drag?.kind === "rulerRay" && drag.line) {
          strokes.push({
            width: Number(document.querySelector("#thickness").value) / zoom,
            color: document.querySelector("#penColor").value,
            parts: [[drag.line.start, drag.line.end]]
          });
        }
        drag = null;
        compass.draggingTip = false;
        draw();
      });
      canvas.addEventListener("pointercancel", () => {
        if (drag?.kind === "compassDraw") compass.drawing = false;
        pointerDown = false; activeStroke = null; drag = null;
        compass.draggingTip = false;
        draw();
      });
      canvas.addEventListener("lostpointercapture", () => {
        if (drag?.kind === "compassDraw") compass.drawing = false;
        pointerDown = false; activeStroke = null; drag = null;
        compass.draggingTip = false;
        draw();
      });

      canvas.addEventListener("wheel", e => {
        e.preventDefault();
        const p = pointerPos(e);
        const before = screenToWorld(p.x, p.y);
        zoom = Math.max(.15, Math.min(4, zoom * (e.deltaY < 0 ? 1.1 : .9)));
        panX = p.x - before.x * zoom;
        panY = p.y - before.y * zoom;
        draw();
      }, { passive: false });

      document.querySelectorAll("[data-tool]").forEach(button => {
        button.addEventListener("click", () => {
          tool = button.dataset.tool;
          document.querySelectorAll("[data-tool]").forEach(b =>
            b.classList.toggle("active", b === button));
        });
      });

      document.querySelectorAll(".color-swatch").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelector("#penColor").value = button.dataset.color;

    document.querySelectorAll(".color-swatch").forEach(swatch => {
      swatch.classList.toggle("active", swatch === button);
    });
  });
});


      document.querySelector("#rulerButton").addEventListener("click", () => {
      console.log("Ruler-Button geklickt");
        ruler.visible = !ruler.visible;
        document.querySelector("#rulerButton").classList.toggle("active", ruler.visible);
        draw();
      });

      document.querySelector("#compassButton").addEventListener("click", () => {
        compass.visible = !compass.visible;
        document.querySelector("#compassButton")
          .classList.toggle("active", compass.visible);
        draw();
      });

      document.querySelector("#themeButton").addEventListener("click", e => {
        body.classList.toggle("dark");
        const icon = body.classList.contains("dark") ? "sun" : "moon";
        e.currentTarget.innerHTML = `<i data-lucide="${icon}"></i>`;
        lucide.createIcons();
        draw();
      });

      document.querySelector("#clearButton").addEventListener("click", () => {
        if (!strokes.length) return;
        recordUndo();
        strokes = [];
        draw();
      });

      function exportSvg(includeTools = false) {
        const rect = canvas.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;
        const left = -panX / zoom;
        const top = -panY / zoom;
        const right = left + width / zoom;
        const bottom = top + height / zoom;
        const dark = body.classList.contains("dark");
        const background = dark ? "#171a20" : "#ffffff";
        const gridColor = dark ? "#343b45" : "#dce3eb";
        const xml = value => String(value).replace(/[&<>"]/g, character => ({
          "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;"
        })[character]);
        const gridLines = [];

        for (let x = Math.floor(left / grid) * grid; x <= right; x += grid) {
          gridLines.push(`<path d="M ${x} ${top} V ${bottom}"/>`);
        }
        for (let y = Math.floor(top / grid) * grid; y <= bottom; y += grid) {
          gridLines.push(`<path d="M ${left} ${y} H ${right}"/>`);
        }

        const paths = [];
        for (const stroke of strokes) {
          const color = stroke.color === "standard" || stroke.color === "#202124" || stroke.color === "#f5f5f5"
            ? (dark ? "#ffffff" : "#000000")
            : stroke.color;
          for (const part of stroke.parts) {
            if (!part.length) continue;
            const d = part.map((point, index) =>
              `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`
            ).join(" ");
            paths.push(`<path d="${d}" fill="none" stroke="${xml(color)}" stroke-width="${stroke.width}" stroke-linecap="round" stroke-linejoin="round"/>`);
          }
        }

        let toolMarkup = "";
        if (includeTools && ruler.visible) {
          const mid = ruler.w / 2;
          const protractorRadius = ruler.h * 0.65;
          const scaleColor = dark ? "#edf5ff" : "#263746";
          const rulerStroke = dark ? "rgba(190,220,245,.9)" : "rgba(45,95,135,.9)";
          const centimeterTicks = [];
          const degreeTicks = [];
          const degreeLabels = [];
          const slantedTicks = [];
          const slantedLabels = [];
          const tickStep = cm / 10;
          const helperLines = [];

          for (let i = 1; i <= 5; i++) {
            const y = -i * cm / 2;
            const halfSpan = mid * (1 + y / ruler.h);
            if (halfSpan > 0) helperLines.push(`<path d="M ${mid - halfSpan} ${y} H ${mid + halfSpan}"/>`);
          }

          for (let i = -Math.floor(mid / tickStep) + 1; i < Math.floor(mid / tickStep); i++) {
            const x = mid + i * tickStep;
            const absolute = Math.abs(i);
            const length = absolute % 10 === 0 ? 18 : absolute % 5 === 0 ? 12 : 7;
            centimeterTicks.push(`<path d="M ${x} 0 V ${-length}"/>`);
            if (absolute % 10 === 0) {
              centimeterTicks.push(`<text x="${x}" y="-22" fill="${scaleColor}" stroke="none" font-size="${13 / zoom}" text-anchor="middle">${absolute / 10}</text>`);
            }
          }

          for (let deg = 0; deg <= 180; deg++) {
            const angle = Math.PI + deg * Math.PI / 180;
            const major = deg % 10 === 0;
            const length = major ? 14 : deg % 5 === 0 ? 10 : 5;
            const inner = protractorRadius - length;
            const x1 = mid + Math.cos(angle) * inner;
            const y1 = Math.sin(angle) * inner;
            const x2 = mid + Math.cos(angle) * protractorRadius;
            const y2 = Math.sin(angle) * protractorRadius;
            degreeTicks.push(`<path d="M ${x1} ${y1} L ${x2} ${y2}"/>`);
            if (major) {
              const labelRadius = protractorRadius - 26;
              degreeLabels.push(`<text x="${mid + Math.cos(angle) * labelRadius}" y="${Math.sin(angle) * labelRadius}" fill="${scaleColor}" stroke="none" font-size="${12 / zoom}" text-anchor="middle" dominant-baseline="middle">${deg}</text>`);
              degreeLabels.push(`<text x="${mid + Math.cos(angle) * (protractorRadius - 48)}" y="${Math.sin(angle) * (protractorRadius - 48)}" fill="${scaleColor}" stroke="none" font-size="${12 / zoom}" text-anchor="middle" dominant-baseline="middle">${180 - deg}</text>`);
            }
          }

          const apex = { x: mid, y: -ruler.h };
          const cross = (a, b) => a.x * b.y - a.y * b.x;
          for (const side of ["left", "right"]) {
            const edgeEnd = { x: side === "left" ? 0 : ruler.w, y: 0 };
            const edge = { x: edgeEnd.x - apex.x, y: edgeEnd.y - apex.y };
            const edgeLength = Math.hypot(edge.x, edge.y);
            const normal = side === "left"
              ? { x: -edge.y / edgeLength, y: edge.x / edgeLength }
              : { x: edge.y / edgeLength, y: -edge.x / edgeLength };
            for (let deg = 0; deg <= 90; deg++) {
              const a = deg * Math.PI / 180;
              const direction = side === "left"
                ? { x: -Math.sin(a), y: -Math.cos(a) }
                : { x: Math.sin(a), y: -Math.cos(a) };
              const denominator = cross(direction, edge);
              if (Math.abs(denominator) < 1e-9) continue;
              const t = cross({ x: apex.x - mid, y: apex.y }, direction) / denominator;
              if (t < -1e-6 || t > 1 + 1e-6) continue;
              const point = { x: apex.x + edge.x * t, y: apex.y + edge.y * t };
              const length = deg % 10 === 0 ? 14 : deg % 5 === 0 ? 10 : 5;
              slantedTicks.push(`<path d="M ${point.x} ${point.y} L ${point.x - normal.x * length} ${point.y - normal.y * length}"/>`);
              if (deg % 10 === 0) {
                slantedLabels.push(`<text x="${point.x + normal.x * 17}" y="${point.y + normal.y * 17}" fill="${scaleColor}" stroke="none" font-size="${11 / zoom}" text-anchor="${side === "left" ? "end" : "start"}" dominant-baseline="middle">${90 - deg}</text>`);
              }
            }
          }

          toolMarkup += `<g transform="translate(${ruler.x} ${ruler.y}) rotate(${ruler.angle * 180 / Math.PI})">` +
            `<path d="M 0 0 L ${ruler.w} 0 L ${mid} ${-ruler.h} Z" fill="${dark ? "rgba(135,190,220,.19)" : "rgba(115,175,220,.22)"}" stroke="${rulerStroke}" stroke-width="${2 / zoom}"/>` +
            `<g fill="none" stroke="${rulerStroke}" stroke-opacity=".45" stroke-width="${1.8 / zoom}">${helperLines.join("")}</g>` +
            `<path d="M ${mid} 0 L ${mid} ${-ruler.h}" fill="none" stroke="${rulerStroke}" stroke-width="${2 / zoom}"/>` +
            `<path d="M ${mid - protractorRadius} 0 A ${protractorRadius} ${protractorRadius} 0 0 1 ${mid + protractorRadius} 0" fill="none" stroke="${rulerStroke}" stroke-width="${2 / zoom}"/>` +
            `<g fill="none" stroke="${rulerStroke}" stroke-width="${1.5 / zoom}">${centimeterTicks.join("")}${degreeTicks.join("")}${slantedTicks.join("")}</g>` +
            `<g font-family="sans-serif">${degreeLabels.join("")}${slantedLabels.join("")}</g>` +
            `<circle cx="${mid}" cy="0" r="${4 / zoom}" fill="#e53935"/><text x="${mid}" y="${-8 / zoom}" fill="${scaleColor}" font-family="sans-serif" font-size="${13 / zoom}" text-anchor="middle">90</text>` +
            `</g>`;
        }

        if (includeTools && compass.visible) {
          const halfGap = compass.radius / 2;
          const armLength = compassArmLength();
          const headX = halfGap;
          const headY = -Math.sqrt(Math.max(0, armLength ** 2 - halfGap ** 2));
          const rotate = compassRotateControl();
          const rotateX = (rotate.x - compass.x) * Math.cos(compass.angle) + (rotate.y - compass.y) * Math.sin(compass.angle);
          const rotateY = -(rotate.x - compass.x) * Math.sin(compass.angle) + (rotate.y - compass.y) * Math.cos(compass.angle);
          toolMarkup += `<g transform="translate(${compass.x} ${compass.y}) rotate(${compass.angle * 180 / Math.PI})" stroke-linecap="round" stroke-linejoin="round">` +
            `<path d="M ${headX} ${headY - 30 / zoom} L 0 ${-30 / zoom} M ${headX} ${headY - 30 / zoom} L ${compass.radius} ${-30 / zoom}" fill="none" stroke="#ed8b19" stroke-width="${12 / zoom}"/>` +
            `<rect x="${headX - 15}" y="${headY - 30 / zoom - 13}" width="30" height="27" rx="${5 / zoom}" fill="#263746"/>` +
            `<rect x="${headX - 6}" y="${headY - 30 / zoom - 32}" width="12" height="19" fill="#263746"/>` +
            `<path d="M ${-5 / zoom} ${-30 / zoom} L ${5 / zoom} ${-30 / zoom} L 0 0 Z" fill="${dark ? "#eef1f5" : "#263746"}"/>` +
            `<path d="M ${compass.radius - 5 / zoom} ${-30 / zoom} L ${compass.radius + 5 / zoom} ${-30 / zoom} L ${compass.radius} 0 Z" fill="#374957"/>` +
            `<circle cx="${headX}" cy="${headY - 30 / zoom - 23}" r="${8 / zoom}" fill="#263746"/>` +
            `<circle cx="0" cy="0" r="${7 / zoom}" fill="#367fc1"/><circle cx="${compass.radius}" cy="0" r="${7 / zoom}" fill="#367fc1"/>` +
            `<circle cx="${rotateX}" cy="${rotateY}" r="${9 / zoom}" fill="#8e24aa"/>` +
            `</g>`;
        }

        const svg = `<?xml version="1.0" encoding="UTF-8"?>\n` +
          `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">` +
          `<rect width="100%" height="100%" fill="${background}"/>` +
          `<g transform="translate(${panX} ${panY}) scale(${zoom})">` +
          `<g fill="none" stroke="${gridColor}" stroke-width="${1.5 / zoom}">${gridLines.join("")}</g>` +
          paths.join("") +
          toolMarkup +
          `</g></svg>`;
        const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `geometrie-zeichnung-${createTimestamp()}.svg`;
        link.style.display = "none";
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

      document.querySelector("#exportSvgButton").addEventListener("click", () => exportSvg(false));
      document.querySelector("#exportSvgWithToolsButton").addEventListener("click", () => exportSvg(true));

      document.querySelector("#saveButton").addEventListener("click", async () => {
        filenameTimestamp ??= createTimestamp();

        const filename = `geometrie-zeichnung-${filenameTimestamp}.json`;
        const data = {
          format: "geometrie-canvas",
          version: 1,
          filenameTimestamp,
          strokes,
          ruler,
          view: { zoom, panX, panY },
          compass: {
          visible: compass.visible,
          x: compass.x,
          y: compass.y,
          angle: compass.angle,
          radius: compass.radius
        }
        };
        const json = JSON.stringify(data, null, 2);

        // Wenn bereits ein Dateihandle gewählt wurde, dieselbe Datei erneut speichern.
        if (saveFileHandle) {
          try {
            const writable = await saveFileHandle.createWritable();
            await writable.write(json);
            await writable.close();
            return;
          } catch (error) {
            console.warn("Konnte die zuvor gewählte Datei nicht speichern.", error);
            saveFileHandle = null;
          }
        }

        if (typeof window.showSaveFilePicker === "function") {
          try {
            saveFileHandle = await window.showSaveFilePicker({
              suggestedName: filename,
              types: [{
                description: "Geometrie-Zeichnung",
                accept: { "application/json": [".json"] }
              }]
            });

            const writable = await saveFileHandle.createWritable();
            await writable.write(json);
            await writable.close();
            return;
          } catch (error) {
            if (error.name === "AbortError") return;
            console.warn("Dateiauswahldialog nicht verfügbar; starte Download.", error);
          }
        }

        const blob = new Blob([json], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = filename;
        link.style.display = "none";
        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });

document.querySelector("#loadButton").addEventListener("click", () => {
  document.querySelector("#loadFile").click();
});

document.querySelector("#loadFile").addEventListener("change", async event => {
  const file = event.target.files[0];
  if (!file) return;

  try {
      const data = JSON.parse(await file.text());

      filenameTimestamp =
        data.filenameTimestamp ??
        file.name.match(/geometrie-zeichnung-(\d{4}-\d{2}-\d{2}-\d{4})\.json$/)?.[1] ??
        null;

    if (
      data.format !== "geometrie-canvas" ||
      !Array.isArray(data.strokes) ||
      !data.ruler ||
      !data.view
    ) {
      throw new Error("Das ist keine gültige Zeichnungsdatei.");
    }

    const isNumber = value =>
      typeof value === "number" && Number.isFinite(value);

    const validStrokes = data.strokes.every(stroke =>
      stroke &&
      typeof stroke.color === "string" &&
      isNumber(stroke.width) &&
      stroke.width > 0 &&
      Array.isArray(stroke.parts) &&
      stroke.parts.every(part =>
        Array.isArray(part) &&
        part.every(point =>
          point && isNumber(point.x) && isNumber(point.y)
        )
      )
    );

    const validRuler =
      isNumber(data.ruler.x) &&
      isNumber(data.ruler.y) &&
      isNumber(data.ruler.w) &&
      isNumber(data.ruler.h) &&
      isNumber(data.ruler.angle) &&
      typeof data.ruler.visible === "boolean";

    const validView =
      isNumber(data.view.zoom) &&
      data.view.zoom > 0 &&
      isNumber(data.view.panX) &&
      isNumber(data.view.panY);

    if (!validStrokes || !validRuler || !validView) {
      throw new Error("Die Zeichnungsdatei enthält ungültige Daten.");
    }

    if (data.compass) {
  const c = data.compass;
  const validCompass =
    typeof c.visible === "boolean" &&
    [c.x, c.y, c.angle, c.radius].every(
      value => typeof value === "number" && Number.isFinite(value)
    ) &&
    c.radius > 0;

  if (!validCompass) {
    throw new Error("Die Zirkel-Einstellungen sind ungültig.");
  }

}

    recordUndo();
    strokes = data.strokes;
    ruler = data.ruler;
    if (data.compass) {
      compass = {
        ...compass,
        ...data.compass,
        drawing: false,
        draggingTip: false
      };
    }

    zoom = Math.max(0.15, Math.min(4, data.view.zoom));
    panX = data.view.panX;
    panY = data.view.panY;

    activeStroke = null;
    draw();
  } catch (error) {
    alert("Die Zeichnung konnte nicht geladen werden: " + error.message);
  } finally {
    event.target.value = "";
  }
});
    lucide.createIcons();
    resize();
    })();
  </script>
</body>
</html>
